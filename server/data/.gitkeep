import { Router } from 'express';
import jwt from 'jsonwebtoken';
import { v4 as uuidv4 } from 'uuid';
import { getDb } from '../db.js';

const router = Router();

function requireAuth(req, res, next) {
  const authHeader = req.headers.authorization;
  if (!authHeader || !authHeader.startsWith('Bearer ')) {
    return res.status(401).json({ message: 'Unauthorized' });
  }

  try {
    const token = authHeader.split(' ')[1];
    const decoded = jwt.verify(token, process.env.JWT_SECRET || 'dev-secret');
    req.user = decoded;
    next();
  } catch (err) {
    return res.status(401).json({ message: 'Invalid token' });
  }
}

router.use(requireAuth);

router.get('/', async (req, res) => {
  const db = getDb();
  const projects = db.data.projects.filter((project) => project.userId === req.user.id);
  res.json({ projects });
});

router.get('/:id', async (req, res) => {
  const db = getDb();
  const project = db.data.projects.find((entry) => entry.id === req.params.id && entry.userId === req.user.id);
  if (!project) return res.status(404).json({ message: 'Project not found' });
  res.json({ project });
});

router.post('/generate', async (req, res) => {
  const { prompt, platform, style } = req.body;
  if (!prompt || !prompt.trim()) {
    return res.status(400).json({ message: 'Prompt is required' });
  }

  const db = getDb();
  const project = {
    id: uuidv4(),
    userId: req.user.id,
    name: `${(platform || 'instagram').toUpperCase()}-${Date.now().toString().slice(-4)}`,
    prompt: prompt.trim(),
    platform: platform || 'instagram',
    style: style || 'cinematic',
    views: Math.floor(Math.random() * 2000) + 150,
    createdAt: new Date().toISOString(),
    cover: 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1200&q=80',
    script: generateScript(prompt, style),
    status: 'ready'
  };

  db.data.projects.unshift(project);
  await db.write();

  res.status(201).json({ project });
});

function generateScript(prompt, style) {
  const styleName = style || 'cinematic';
  return {
    style: styleName,
    hook: 'Use a bold opening frame within the first 1–2 seconds.',
    scenes: [
      'Open on the strongest visual element from the prompt.',
      'Add motion and contrast to sustain attention.',
      'Close with a memorable CTA or brand reveal.'
    ],
    cta: 'Follow for more creative templates.',
    prompt
  };
}

export default router;



